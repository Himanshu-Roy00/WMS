@model List<WMS.Models.Supplier>

@{
    ViewData["Title"] = "Supplier Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-custom">

    <div class="card-header border-0 pt-6 pb-4">
        <div class="d-flex justify-content-between align-items-center w-100">
            <div class="card-title">
                <h3 class="card-label">
                    Supplier Management
                    <span class="d-block text-muted pt-2 font-size-sm">
                        Manage all your suppliers
                    </span>
                </h3>
            </div>
            <div class="card-toolbar d-flex align-items-center">
                <form method="get" action="/Supplier/Supplier" class="d-flex align-items-center mr-3">
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control mr-2"
                           placeholder="Search supplier..."
                           style="width:200px;" />
                    <button type="submit"
                            class="btn btn-light-primary font-weight-bolder">
                        Search
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                    {
                        <a href="/Supplier/Supplier"
                               class="btn btn-light-danger font-weight-bolder ml-2">
                            Clear
                        </a>
                    }
                </form>
                <button type="button"
                        class="btn btn-primary font-weight-bolder"
                        onclick="openAddModal()">
                    Add Supplier
                </button>
            </div>
        </div>
    </div>

    <div class="card-body">

        <table class="table table-bordered table-hover">

            <thead class="thead-light">

                <tr>
                    <th>#</th>
                    <th>Supplier Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Count > 0)
                {
                    int count = 1;

                    foreach (var item in Model)
                    {
                        <tr>

                            <td>@count</td>

                            <td>@item.Name</td>

                            <td>@item.Phone</td>

                            <td>@item.Email</td>

                            <td>@item.Address</td>

                            <td>

                                <button type="button"
                                        class="btn btn-warning btn-sm"
                                        onclick="openEditModal('@item.Id',
                                    '@item.Name',
                                    '@item.Phone',
                                    '@item.Email',
                                    '@item.Address')">

                                    Edit

                                </button>

                                <a href="/Supplier/Delete/@item.Id"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure?')">

                                    Delete

                                </a>

                            </td>

                        </tr>

                        count++;
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-danger">

                            No Suppliers Found

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- MODAL -->

<div class="modal fade"
     id="supplierModal"
     tabindex="-1"
     role="dialog"
     aria-hidden="true">

    <div class="modal-dialog"
         role="document">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="modalTitle">

                    Supplier

                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal">

                    <span>&times;</span>

                </button>

            </div>

            <div class="modal-body">

                <form method="post"
                      id="supplierForm">

                    <input type="hidden"
                           id="Id"
                           name="Id" />

                    <div class="form-group">

                        <label>Supplier Name</label>

                        <input type="text"
                               id="Name"
                               name="Name"
                               class="form-control"
                               required />

                    </div>

                    <div class="form-group">

                        <label>Phone</label>

                        <input type="text"
                               id="Phone"
                               name="Phone"
                               class="form-control" />

                    </div>

                    <div class="form-group">

                        <label>Email</label>

                        <input type="email"
                               id="Email"
                               name="Email"
                               class="form-control" />

                    </div>

                    <div class="form-group">

                        <label>Address</label>

                        <textarea id="Address"
                                  name="Address"
                                  class="form-control"
                                  rows="3"></textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">

                        Save

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<script>

    function openAddModal() {

        $("#Id").val('');
        $("#Name").val('');
        $("#Phone").val('');
        $("#Email").val('');
        $("#Address").val('');

        $("#supplierForm").attr("action", "/Supplier/Add");

        $("#modalTitle").text("Add Supplier");

        $("#supplierModal").modal('show');
    }

    function openEditModal(id, name, phone, email, address) {

        $("#Id").val(id);
        $("#Name").val(name);
        $("#Phone").val(phone);
        $("#Email").val(email);
        $("#Address").val(address);

        $("#supplierForm").attr("action", "/Supplier/Edit");

        $("#modalTitle").text("Edit Supplier");

        $("#supplierModal").modal('show');
    }

</script>