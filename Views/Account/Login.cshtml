@model WMS.Models.User

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>

            body {
                overflow-x: hidden;
            }

            #loginSection {
                min-height: 100vh;
                background-color: #f8f6f1;
            }

            .login-box {
                background-color: #0e2207;
                border-radius: 30px;
            }

            .form-control {
                padding: 14px;
                border-radius: 10px;
            }

            .login-btn {
                background-color: #f8a01d;
                color: white;
                font-weight: bold;
                padding: 12px;
            }

                .login-btn:hover {
                    background-color: #e28d12;
                    color: white;
                }

            .social-btn {
                border-radius: 50px;
            }

            .title-text {
                color: white;
            }

            .top-banner {
                background-color: #0e2207d5;
                height: 250px;
            }
    </style>

</head>

<body>

    <!-- Top Banner -->
    <div class="container-fluid top-banner">

        <div class="text-center pt-5">

            <div class="d-inline-block px-5 py-3 text-light rounded-pill"
                 style="background-color:#ffffff3f; margin-top:40px;">

                <a href="/" class="text-decoration-none text-white">
                    Home
                </a>

                &nbsp;&nbsp;/&nbsp;&nbsp;Login
            </div>

            <h1 class="display-4 fw-bold text-white mt-4">
                Warehouse Management System
            </h1>

        </div>

    </div>

    <!-- Login Section -->
    <div class="container-fluid mt-5" id="loginSection">

        <div class="row">

            <div class="col-sm-10 mx-auto shadow-lg login-box p-5"
                 >

                <div class="row">

                    <!-- Left Side -->
                    <div class="col-md-6 text-white">

                        <h1 class="display-3 fw-bold">
                            LOGIN
                        </h1>

                        <h2 class="mb-4">
                            WMS User
                        </h2>

                        <p class="mb-5">
                            Login to manage warehouse products,
                            categories, stock and inventory.
                        </p>

                        <form asp-action="Login" method="post">

                            <div class="mb-4">

                                <label class="form-label h5">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="Enter Email" />

                            </div>

                            <div class="mb-4">

                                <label class="form-label h5">
                                    Password
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Enter Password" />

                            </div>

                            <button type="submit"
                                    class="btn login-btn w-100">
                                Sign In
                            </button>

                            <h5 class="text-danger mt-3">
                                @ViewBag.Message
                            </h5>

                            <p class="text-center mt-4">
                                or login with
                            </p>

                            <div class="row">

                                <div class="col-4">
                                    <button type="button"
                                            class="btn btn-outline-light social-btn w-100">

                                        <i class="fa-brands fa-google"></i>

                                    </button>
                                </div>

                                <div class="col-4">
                                    <button type="button"
                                            class="btn btn-outline-light social-btn w-100">

                                        <i class="fa-solid fa-envelope"></i>

                                    </button>
                                </div>

                                <div class="col-4">
                                    <button type="button"
                                            class="btn btn-outline-light social-btn w-100">

                                        <i class="fa-brands fa-facebook-f"></i>

                                    </button>
                                </div>

                            </div>

                            <p class="text-center mt-5">

                                Don't have an account ?

                                <a asp-action="Register"
                                       class="text-white fw-bold text-decoration-none">

                                    Register Here

                                </a>

                            </p>

                        </form>

                    </div>

                    <!-- Right Side -->
                    <div class="col-md-6 text-center">

                        <img src="https://cdn-icons-png.flaticon.com/512/3081/3081559.png"
                             class="img-fluid"
                             style="max-height:450px;" />

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>