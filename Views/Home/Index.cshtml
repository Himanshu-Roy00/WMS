@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>Warehouse Management System</title>

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                overflow-x: hidden;
                font-family: Arial;
            }

            /* Navbar */

            .navbar {
                background-color: rgba(0,0,0,0.7);
            }

            .navbar-brand {
                font-size: 30px;
                font-weight: bold;
                color: #ffb703 !important;
            }

            .nav-link {
                color: white !important;
                margin-left: 20px;
                font-size: 18px;
            }

                .nav-link:hover {
                    color: #ffb703 !important;
                }

            /* Hero Section */

            .hero {
                width: 100%;
                min-height: 100vh;
                background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=1470&auto=format&fit=crop');
                background-size: cover;
                background-position: center;
                display: flex;
                align-items: center;
            }

            .hero-text h1 {
                font-size: 65px;
                font-weight: bold;
                color: white;
            }

            .hero-text p {
                color: white;
                font-size: 20px;
                margin-top: 20px;
            }

            .hero-btn {
                background-color: #ffb703;
                color: black;
                font-weight: bold;
                padding: 14px 35px;
                border-radius: 10px;
                margin-top: 25px;
            }

                .hero-btn:hover {
                    background-color: white;
                }

            /* Features */

            .feature-card {
                border-radius: 20px;
                transition: 0.3s;
            }

                .feature-card:hover {
                    transform: translateY(-10px);
                }

            .feature-icon {
                font-size: 55px;
                color: #ffb703;
            }

            /* Footer */

            .footer {
                background-color: #111;
                color: white;
                padding: 20px;
            }

    </style>

</head>

<body>

    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">

        <div class="container">

            <a class="navbar-brand" href="#">
                WMS
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            Services
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            Login
                        </a>
                    </li>



                </ul>

            </div>

        </div>

    </nav>

    <!-- Hero Section -->

    <section class="hero">

        <div class="container">

            <div class="row">

                <div class="col-md-7 hero-text">

                    <h1>
                        Warehouse Management System
                    </h1>

                    <p>
                        Manage inventory, products, suppliers,
                        warehouses and stock operations easily
                        with a smart and modern system.
                    </p>

                    <a asp-controller="Account"
                           asp-action="Login"
                           class="btn hero-btn">

                        Get Started

                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- Features -->

    <section class="py-5 bg-light">

        <div class="container">

            <div class="text-center mb-5">

                <h1 class="fw-bold">
                    Our Features
                </h1>

                <p>
                    Smart warehouse management services
                </p>

            </div>

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="card border-0 shadow p-4 text-center feature-card">

                        <i class="fa-solid fa-boxes-stacked feature-icon"></i>

                        <h3 class="mt-4">
                            Inventory Management
                        </h3>

                        <p>
                            Easily manage warehouse inventory
                            and product stock.
                        </p>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card border-0 shadow p-4 text-center feature-card">

                        <i class="fa-solid fa-chart-column feature-icon"></i>

                        <h3 class="mt-4">
                            Reports & Analytics
                        </h3>

                        <p>
                            View smart reports and analytics
                            for warehouse activities.
                        </p>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card border-0 shadow p-4 text-center feature-card">

                        <i class="fa-solid fa-truck feature-icon"></i>

                        <h3 class="mt-4">
                            Supplier Management
                        </h3>

                        <p>
                            Track suppliers and stock movement
                            easily and securely.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- Footer -->

    <footer class="footer text-center">

        <h5>
            © 2026 Warehouse Management System
        </h5>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>