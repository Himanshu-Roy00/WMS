@model List<WMS.Models.ProductStock>

@{
    ViewData["Title"] = "Product Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-custom">

    <div class="card-header">

        <div class="card-title">
            <h3 class="card-label">
                Product Stock Management
            </h3>
        </div>

        <div class="card-toolbar">

            <button type="button"
                    class="btn btn-primary"
                    onclick="openAddModal()">

                Add Stock

            </button>

        </div>

    </div>

    <div class="card-body">

        <table class="table table-bordered">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th>Warehouse</th>
                    <th>Quantity</th>
                    <th>Last Updated</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Count > 0)
                {
                    int count = 1;

                    foreach (var item in Model)
                    {
                        <tr>

                            <td>@count</td>

                            <td>@item.Product?.ProductName</td>

                            <td>@item.Warehouse?.Name</td>

                            <td>@item.Quantity</td>

                            <td>@item.LastUpdated.ToShortDateString()</td>

                            <td>

                                <button class="btn btn-warning btn-sm"
                                        onclick="openEditModal(
                                    '@item.StockId',
                                    '@item.ProductId',
                                    '@item.WarehouseId',
                                    '@item.Quantity')">

                                    Edit

                                </button>

                                <a href="/ProductStock/Delete/@item.StockId"
                                       class="btn btn-danger btn-sm">

                                    Delete

                                </a>

                            </td>

                        </tr>

                        count++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-danger">
                            No Stock Found
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- MODAL -->

<div class="modal fade"
     id="productStockModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="modalTitle">
                    Product Stock
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal">
                    <span>&times;</span>
                </button>

            </div>

            <div class="modal-body">

                <form method="post"
                      id="productStockForm">

                    <input type="hidden"
                           id="StockId"
                           name="StockId" />

                    <div class="form-group">

                        <label>Product</label>

                        <select id="ProductId"
                                name="ProductId"
                                class="form-control"
                                required>

                            <option value="">
                                -- Select Product --
                            </option>

                            @foreach (var item in ViewBag.ProductList)
                            {
                                <option value="@item.Value">
                                    @item.Text
                                </option>
                            }

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Warehouse</label>

                        <select id="WarehouseId"
                                name="WarehouseId"
                                class="form-control"
                                required>

                            <option value="">
                                -- Select Warehouse --
                            </option>

                            @foreach (var item in ViewBag.WarehouseList)
                            {
                                <option value="@item.Value">
                                    @item.Text
                                </option>
                            }

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Quantity</label>

                        <input type="number"
                               id="Quantity"
                               name="Quantity"
                               class="form-control"
                               required />

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<script>

    function openAddModal() {

        $("#StockId").val('');
        $("#ProductId").val('');
        $("#WarehouseId").val('');
        $("#Quantity").val('');

        $("#productStockForm").attr("action", "/ProductStock/Add");

        $("#modalTitle").text("Add Stock");

        $("#productStockModal").modal('show');
    }

    function openEditModal(stockId,
                           productId,
                           warehouseId,
                           quantity) {

        $("#StockId").val(stockId);
        $("#ProductId").val(productId);
        $("#WarehouseId").val(warehouseId);
        $("#Quantity").val(quantity);

        $("#productStockForm").attr("action", "/ProductStock/Edit");

        $("#modalTitle").text("Edit Stock");

        $("#productStockModal").modal('show');
    }

</script>