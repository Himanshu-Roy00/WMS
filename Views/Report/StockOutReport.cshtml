@model List<WMS.Models.StockOut>

@{
    ViewData["Title"] = "Stock Out Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-custom">
    <div class="card-header">
        <div class="card-title">
            <h3 class="card-label">Stock Out Report</h3>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th>Warehouse</th>
                    <th>Quantity</th>
                    <th>Issued To</th>
                    <th>Date</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    int count = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@count</td>
                            <td>@item.Product?.ProductName</td>
                            <td>@item.Warehouse?.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.IssuedTo</td>
                            <td>@item.Date.ToShortDateString()</td>
                            <td>@item.Remarks</td>
                        </tr>
                        count++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-danger">
                            No Stock Out Records Found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>